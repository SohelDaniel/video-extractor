# Copy this file to backend/.env and fill in the values.

# API provider for AI lecture notes: "openrouter" or "claude_code" (uses the local `claude` CLI)
API_PROVIDER=openrouter

# OpenRouter API key — needed only for lecture notes / translation with API_PROVIDER=openrouter.
# Get one at https://openrouter.ai/keys . Transcription works without it.
OPENROUTER_API_KEY=

# Base URL used for clickable timestamp links in generated PDFs
APP_BASE_URL=http://localhost:3000

# Optional: backend port (default 5001; macOS AirPlay Receiver occupies 5000).
# If you change it, also change API_URL in lib/api.js.
# BACKEND_PORT=5001

# Optional: override the MLX Whisper model (default: mlx-community/whisper-large-v3-turbo)
# Faster, lower-accuracy option: mlx-community/whisper-small-mlx
# WHISPER_MODEL=mlx-community/whisper-large-v3-turbo
